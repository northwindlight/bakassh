<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root_terminal"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/term_background"
    android:fitsSystemWindows="false"
    android:orientation="vertical">
    <LinearLayout
        android:id="@+id/layout_terminal_toolbar"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:background="@color/term_background"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="16dp"
        android:paddingEnd="4dp">
        <ImageButton
            android:id="@+id/btn_term_sessions"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/sessions"
            android:padding="12dp"
            android:src="@drawable/ic_sessions"
            app:tint="?attr/colorOnSurfaceVariant" />
        <TextView
            android:id="@+id/tv_term_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="middle"
            android:fontFamily="sans-serif-medium"
            android:singleLine="true"
            android:text="@string/terminal_title"
            android:textColor="?attr/colorOnSurface"
            android:textSize="15sp" />
        <TextView
            android:id="@+id/tv_term_cols"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="4dp"
            android:text="@string/terminal_initial_columns"
            android:textColor="?attr/colorOnSurfaceVariant"
            android:textSize="12sp" />
        <ImageButton
            android:id="@+id/btn_term_paste"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/paste"
            android:padding="8dp"
            android:src="@drawable/ic_content_paste"
            app:tint="?attr/colorOnSurfaceVariant" />
        <ImageButton
            android:id="@+id/btn_term_keyboard"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/keyboard"
            android:padding="8dp"
            android:src="@drawable/ic_keyboard"
            app:tint="?attr/colorOnSurfaceVariant" />
        <ImageButton
            android:id="@+id/btn_term_exit"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/more_actions"
            android:padding="8dp"
            android:src="@drawable/ic_more_vert"
            app:tint="?attr/colorOnSurfaceVariant" />
    </LinearLayout>
    <FrameLayout
        android:id="@+id/layout_terminal_container"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">
        <dev.northwind.bakassh.TerminalView
            android:id="@+id/terminal_view"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />
    </FrameLayout>
    <LinearLayout
        android:id="@+id/layout_extra_keys_box"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="?attr/colorSurfaceContainer"
        android:orientation="vertical"
        android:paddingTop="3dp"
        android:paddingBottom="3dp" />
</LinearLayout>
