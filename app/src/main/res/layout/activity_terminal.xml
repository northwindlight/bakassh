<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root_terminal"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/term_background"
    android:fitsSystemWindows="false"
    android:orientation="vertical">

    <!-- 终端顶栏：平直、深色，和 Material 3 的 small top app bar 一致 -->
    <LinearLayout
        android:id="@+id/layout_terminal_toolbar"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:background="@color/status_bar_bg"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="16dp"
        android:paddingEnd="4dp">

        <TextView
            android:id="@+id/tv_term_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="middle"
            android:fontFamily="sans-serif-medium"
            android:singleLine="true"
            android:text="SSH 终端"
            android:textColor="?attr/colorOnSurface"
            android:textSize="15sp" />

        <TextView
            android:id="@+id/tv_term_cols"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="4dp"
            android:text="150列"
            android:textColor="?attr/colorOnSurfaceVariant"
            android:textSize="12sp" />

        <ImageButton
            android:id="@+id/btn_term_paste"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="粘贴"
            android:padding="8dp"
            android:src="@drawable/ic_content_copy"
            app:tint="?attr/colorOnSurfaceVariant" />

        <ImageButton
            android:id="@+id/btn_term_keyboard"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="键盘"
            android:padding="8dp"
            android:src="@drawable/ic_keyboard"
            app:tint="?attr/colorOnSurfaceVariant" />

        <ImageButton
            android:id="@+id/btn_term_exit"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="断开连接"
            android:padding="8dp"
            android:src="@drawable/ic_close"
            app:tint="?attr/colorOnSurfaceVariant" />
    </LinearLayout>

    <!-- 终端视图容器 -->
    <FrameLayout
        android:id="@+id/layout_terminal_container"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <dev.northwind.bakassh.TerminalView
            android:id="@+id/terminal_view"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />
    </FrameLayout>

    <!-- 底部扩展按键栏容器 -->
    <LinearLayout
        android:id="@+id/layout_extra_keys_box"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="?attr/colorSurfaceContainer"
        android:orientation="vertical"
        android:paddingTop="3dp"
        android:paddingBottom="3dp" />

</LinearLayout>
