<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_drag_handle"
    android:backgroundTint="@color/md_theme_surfaceContainerHigh"
    android:orientation="vertical"
    android:paddingStart="24dp"
    android:paddingTop="12dp"
    android:paddingEnd="24dp"
    android:paddingBottom="24dp">

    <!-- 顶部拖动手柄 -->
    <View
        android:layout_width="36dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginBottom="16dp"
        android:background="@drawable/bg_drag_handle" />

    <TextView
        android:id="@+id/tv_detail_key_name"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="密钥公钥"
        android:textColor="@color/md_theme_onSurface"
        android:textSize="22sp"
        android:textStyle="bold"
        android:fontFamily="sans-serif-medium" />

    <TextView
        android:id="@+id/tv_detail_key_info"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:layout_marginBottom="14dp"
        android:text="类型: RSA-3072\n指纹: SHA256:..."
        android:textColor="@color/md_theme_onSurfaceVariant"
        android:textSize="12sp"
        android:lineSpacingExtra="2dp" />

    <!-- 公钥展示框 -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_chip_tag"
        android:backgroundTint="@color/md_theme_surfaceContainerHighest"
        android:padding="14dp">

        <TextView
            android:id="@+id/tv_detail_pubkey"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="monospace"
            android:maxLines="8"
            android:scrollbars="vertical"
            android:textIsSelectable="true"
            android:textColor="@color/md_theme_onSurface"
            android:textSize="12sp"
            android:lineSpacingExtra="3dp" />
    </FrameLayout>

    <!-- 底部按钮 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:orientation="horizontal">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_close_detail"
            style="@style/Widget.Material3.Button.TonalButton"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:text="关闭"
            android:textColor="@color/md_theme_onSecondaryContainer"
            app:cornerRadius="24dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_copy_pubkey"
            style="@style/Widget.Material3.Button"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:text="复制公钥"
            android:textColor="@color/md_theme_onPrimary"
            app:icon="@drawable/ic_content_copy"
            app:iconTint="@color/md_theme_onPrimary"
            app:backgroundTint="@color/md_theme_primary"
            app:cornerRadius="24dp" />
    </LinearLayout>

</LinearLayout>
