<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_drag_handle"
    android:backgroundTint="@color/md_theme_surfaceContainerHigh"
    android:orientation="vertical"
    android:paddingStart="24dp"
    android:paddingTop="12dp"
    android:paddingEnd="24dp"
    android:paddingBottom="24dp">

    <!-- 顶部拖动手柄 -->
    <View
        android:layout_width="36dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginBottom="16dp"
        android:background="@drawable/bg_drag_handle" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="扩展按键配置"
        android:textColor="@color/md_theme_onSurface"
        android:textSize="22sp"
        android:textStyle="bold"
        android:fontFamily="sans-serif-medium" />

    <TextView
        android:id="@+id/tv_extra_keys_legend"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:layout_marginBottom="14dp"
        android:text="用「|」分行、「,」分键。可用键名：\nESC TAB ENTER BKSP SPACE DEL INS\nUP DOWN LEFT RIGHT HOME END PGUP PGDN\nCTRL ALT SHIFT KEYBOARD PASTE FONT- FONT+"
        android:textColor="@color/md_theme_onSurfaceVariant"
        android:textSize="12sp"
        android:lineSpacingExtra="3dp" />

    <!-- 按键序列输入框 -->
    <com.google.android.material.textfield.TextInputLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="按键布局定义"
        app:boxBackgroundMode="filled"
        app:boxBackgroundColor="@color/md_theme_surfaceContainerHighest"
        app:boxCornerRadiusTopStart="14dp"
        app:boxCornerRadiusTopEnd="14dp"
        app:boxCornerRadiusBottomStart="14dp"
        app:boxCornerRadiusBottomEnd="14dp"
        app:boxStrokeWidth="0dp"
        app:boxStrokeWidthFocused="1.5dp"
        app:boxStrokeColor="@color/md_theme_primary">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/et_extra_keys_config"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="monospace"
            android:inputType="text"
            android:textColor="@color/md_theme_onSurface"
            android:textSize="13sp" />
    </com.google.android.material.textfield.TextInputLayout>

    <!-- 底部按钮 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:orientation="horizontal">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_reset_extra_keys"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:text="恢复默认"
            android:textSize="13sp"
            app:cornerRadius="24dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_save_extra_keys"
            style="@style/Widget.Material3.Button"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:text="保存配置"
            android:textColor="@color/md_theme_onPrimary"
            app:backgroundTint="@color/md_theme_primary"
            app:cornerRadius="24dp" />
    </LinearLayout>

</LinearLayout>
