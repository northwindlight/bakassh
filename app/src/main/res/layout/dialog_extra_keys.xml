<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="?attr/colorSurface"
    android:fitsSystemWindows="true">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="64dp"
        android:gravity="center_vertical"
        android:paddingEnd="12dp">
        <ImageButton
            android:id="@+id/btn_cancel_extra_keys"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:padding="16dp"
            android:src="@drawable/ic_arrow_back"
            app:tint="?attr/colorOnSurface"
            android:contentDescription="@string/navigate_back" />
        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="@string/extra_keys_title"
            android:textSize="22sp"
            android:textColor="?attr/colorOnSurface"
            android:id="@+id/tv_dialog_title"
            android:layout_weight="1" />
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_save_extra_keys"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minHeight="48dp"
            android:text="@string/save" />
    </LinearLayout>
    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true"
        android:clipToPadding="false">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="24dp"
            android:paddingEnd="24dp"
            android:paddingBottom="32dp">
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/extra_keys_section"
                android:textSize="14sp"
                android:textColor="?attr/colorPrimary"
                android:paddingTop="28dp"
                android:paddingBottom="16dp"
                android:fontFamily="sans-serif-medium" />
            <com.google.android.material.textfield.TextInputLayout
                style="@style/Widget.Baka.TextField"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                android:hint="@string/extra_keys_layout"
                app:helperText="@string/extra_keys_layout_help">
                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/et_extra_keys_config"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="textMultiLine"
                    android:textSize="16sp"
                    android:fontFamily="monospace"
                    android:minLines="4"
                    android:gravity="top" />
            </com.google.android.material.textfield.TextInputLayout>
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/extra_keys_available"
                android:textSize="14sp"
                android:textColor="?attr/colorPrimary"
                android:paddingTop="28dp"
                android:paddingBottom="16dp"
                android:fontFamily="sans-serif-medium" />
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/extra_keys_legend"
                android:textSize="14sp"
                android:textColor="?attr/colorOnSurfaceVariant"
                android:fontFamily="monospace"
                android:lineSpacingExtra="8dp" />
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_reset_extra_keys"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minHeight="48dp"
                android:text="@string/restore_default"
                android:layout_gravity="start"
                android:layout_marginTop="24dp" />
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</LinearLayout>
