<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
      主界面主题：Material 3 DayNight。
      颜色全部走主题属性（?attr/），深色值自动来自 values-night，
      Android 12+ 上 DynamicColors 还能把整页替换成壁纸色调。
    -->
    <style name="AppTheme" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/md_theme_primary</item>
        <item name="colorOnPrimary">@color/md_theme_onPrimary</item>
        <item name="colorPrimaryContainer">@color/md_theme_primaryContainer</item>
        <item name="colorOnPrimaryContainer">@color/md_theme_onPrimaryContainer</item>

        <item name="colorSecondary">@color/md_theme_secondary</item>
        <item name="colorOnSecondary">@color/md_theme_onSecondary</item>
        <item name="colorSecondaryContainer">@color/md_theme_secondaryContainer</item>
        <item name="colorOnSecondaryContainer">@color/md_theme_onSecondaryContainer</item>

        <item name="colorTertiary">@color/md_theme_tertiary</item>
        <item name="colorOnTertiary">@color/md_theme_onTertiary</item>
        <item name="colorTertiaryContainer">@color/md_theme_tertiaryContainer</item>
        <item name="colorOnTertiaryContainer">@color/md_theme_onTertiaryContainer</item>

        <item name="colorError">@color/md_theme_error</item>
        <item name="colorOnError">@color/md_theme_onError</item>
        <item name="colorErrorContainer">@color/md_theme_errorContainer</item>
        <item name="colorOnErrorContainer">@color/md_theme_onErrorContainer</item>

        <item name="colorSurface">@color/md_theme_surface</item>
        <item name="colorOnSurface">@color/md_theme_onSurface</item>
        <item name="colorSurfaceVariant">@color/md_theme_surfaceVariant</item>
        <item name="colorOnSurfaceVariant">@color/md_theme_onSurfaceVariant</item>
        <item name="colorSurfaceContainerLowest">@color/md_theme_surfaceContainerLowest</item>
        <item name="colorSurfaceContainerLow">@color/md_theme_surfaceContainerLow</item>
        <item name="colorSurfaceContainer">@color/md_theme_surfaceContainer</item>
        <item name="colorSurfaceContainerHigh">@color/md_theme_surfaceContainerHigh</item>
        <item name="colorSurfaceContainerHighest">@color/md_theme_surfaceContainerHighest</item>
        <item name="colorOnBackground">@color/md_theme_onBackground</item>
        <item name="colorOutline">@color/md_theme_outline</item>
        <item name="colorOutlineVariant">@color/md_theme_outlineVariant</item>

        <item name="android:windowBackground">@color/md_theme_surface</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>

        <item name="bottomSheetDialogTheme">@style/PixelBottomSheetDialogTheme</item>
        <item name="materialAlertDialogTheme">@style/PixelAlertDialogTheme</item>
    </style>

    <!-- 底部抽屉：28dp 顶角圆角，颜色跟随当前主题（浅/深/壁纸色） -->
    <style name="PixelBottomSheetDialogTheme" parent="ThemeOverlay.Material3.BottomSheetDialog">
        <item name="bottomSheetStyle">@style/PixelBottomSheetModalStyle</item>
    </style>

    <style name="PixelBottomSheetModalStyle" parent="Widget.Material3.BottomSheet.Modal">
        <item name="backgroundTint">?attr/colorSurfaceContainerLow</item>
        <item name="shapeAppearance">@style/ShapeAppearance.Pixel.BottomSheet</item>
    </style>

    <style name="ShapeAppearance.Pixel.BottomSheet" parent="ShapeAppearance.Material3.Corner.ExtraLarge">
        <item name="cornerSizeTopLeft">28dp</item>
        <item name="cornerSizeTopRight">28dp</item>
        <item name="cornerSizeBottomLeft">0dp</item>
        <item name="cornerSizeBottomRight">0dp</item>
    </style>

    <style name="PixelAlertDialogTheme" parent="ThemeOverlay.Material3.MaterialAlertDialog">
        <item name="shapeAppearance">@style/ShapeAppearance.Pixel.Dialog</item>
        <item name="colorSurface">?attr/colorSurfaceContainerHigh</item>
    </style>

    <style name="ShapeAppearance.Pixel.Dialog" parent="ShapeAppearance.Material3.Corner.ExtraLarge">
        <item name="cornerSize">28dp</item>
    </style>

    <!-- 分段按钮（公钥/密码）左右两端的连接圆角 -->
    <style name="ShapeAppearance.Pixel.SegmentStart" parent="ShapeAppearance.Material3.Corner.None">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSizeTopLeft">20dp</item>
        <item name="cornerSizeBottomLeft">20dp</item>
        <item name="cornerSizeTopRight">0dp</item>
        <item name="cornerSizeBottomRight">0dp</item>
    </style>

    <style name="ShapeAppearance.Pixel.SegmentEnd" parent="ShapeAppearance.Material3.Corner.None">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSizeTopRight">20dp</item>
        <item name="cornerSizeBottomRight">20dp</item>
        <item name="cornerSizeTopLeft">0dp</item>
        <item name="cornerSizeBottomLeft">0dp</item>
    </style>

    <!--
      终端界面：固定深色，不跟随系统/DayNight（终端底色本来就不该变白）。
      这里显式给出深色属性，弹窗、输入框、扩展按键才有正确的对比度。
    -->
    <style name="TermTheme" parent="Theme.Material3.Dark.NoActionBar">
        <item name="colorPrimary">@color/term_primary</item>
        <item name="colorOnPrimary">@color/term_on_primary</item>
        <item name="colorPrimaryContainer">@color/term_primary_container</item>
        <item name="colorOnPrimaryContainer">@color/term_on_primary_container</item>
        <item name="colorSecondaryContainer">@color/term_secondary_container</item>
        <item name="colorOnSecondaryContainer">@color/term_on_secondary_container</item>
        <item name="colorError">@color/term_error</item>
        <item name="colorOnError">@color/term_on_error</item>

        <item name="colorSurface">@color/term_surface</item>
        <item name="colorOnSurface">@color/term_on_surface</item>
        <item name="colorSurfaceVariant">@color/term_outline_variant</item>
        <item name="colorOnSurfaceVariant">@color/term_on_surface_variant</item>
        <item name="colorSurfaceContainer">@color/term_surface_container</item>
        <item name="colorSurfaceContainerHigh">@color/term_surface_container_high</item>
        <item name="colorSurfaceContainerHighest">@color/term_surface_container_highest</item>
        <item name="colorOutline">@color/term_outline</item>
        <item name="colorOutlineVariant">@color/term_outline_variant</item>

        <item name="android:windowFullscreen">true</item>
        <item name="android:windowContentOverlay">@null</item>
        <item name="android:windowBackground">@color/term_background</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@color/term_background</item>

        <item name="bottomSheetDialogTheme">@style/PixelBottomSheetDialogTheme</item>
        <item name="materialAlertDialogTheme">@style/PixelAlertDialogTheme</item>
    </style>
</resources>
